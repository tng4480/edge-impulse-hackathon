<?xml version="1.0" encoding="utf-8"?>
<!-- Round screen. The first screen holds what matters: link state, heart rate, Start/Stop and
     "I feel unwell". SpO2, sensor notes and the board address sit below. Side padding keeps
     text inside the circle. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingTop="18dp"
        android:paddingEnd="30dp"
        android:paddingBottom="52dp">

        <TextView
            android:id="@+id/fakeBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="@color/fake"
            android:paddingHorizontal="8dp"
            android:text="FAKE DATA BUILD"
            android:textColor="@color/paper"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill_status"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="12dp"
            android:paddingVertical="3dp"
            android:text="● Stopped"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="--"
                android:textColor="@color/paper"
                android:textSize="40sp" />

            <TextView
                style="@style/Label"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="8dp"
                android:text="bpm" />
        </LinearLayout>


        <Button
            android:id="@+id/toggle"
            style="@style/Pill"
            android:background="@drawable/pill_primary"
            android:text="Start monitoring"
            android:textColor="@color/ink" />

        <Button
            android:id="@+id/unwell"
            style="@style/Pill"
            android:background="@drawable/pill_alert"
            android:text="Hold: I feel unwell"
            android:textColor="@color/ink" />

        <TextView
            android:id="@+id/checkinStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/paper"
            android:text="Press and hold to tell the nurse team"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/linkDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    style="@style/Label"
                    android:text="SpO2" />

                <TextView
                    android:id="@+id/spo2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/paper"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    style="@style/Label"
                    android:text="Skin" />

                <TextView
                    android:id="@+id/skin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/paper"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/measureSpo2"
            style="@style/Pill"
            android:text="Measure SpO2" />

        <Button
            android:id="@+id/ecgCheck"
            style="@style/Pill"
            android:text="ECG check" />

        <TextView
            android:id="@+id/ecgStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/sensorNotes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <TextView
            style="@style/Label"
            android:layout_marginTop="16dp"
            android:text="Board IP" />

        <EditText
            android:id="@+id/host"
            style="@style/Field"
            android:digits="0123456789."
            android:inputType="numberDecimal" />

        <TextView
            style="@style/Label"
            android:layout_marginTop="6dp"
            android:text="Port" />

        <EditText
            android:id="@+id/port"
            style="@style/Field"
            android:inputType="number" />

        <Button
            android:id="@+id/save"
            style="@style/Pill"
            android:text="Save address" />
    </LinearLayout>
</ScrollView>
